+/// True once if the trace wants the machine code around the current pc dumped.
+pub fn ir_take_dump_request() -> bool {
+    IR_WANT_DUMP.swap(false, std::sync::atomic::Ordering::Relaxed)
+}
+
+static IR_LAST_MASK: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0xFFFF_FFFF);
+
+/// Log changes of the interrupt mask, with the interrupt numbers it leaves on
+/// (bit 32-n clear = interrupt n on). Shows which interrupt the UART uses.
+fn ir_mask_note(now: f64, mask: u32) {
+    if IR_LAST_MASK.swap(mask, std::sync::atomic::Ordering::Relaxed) == mask {
+        return;
+    }
+    let on: Vec<String> = (1..=32u32).filter(|n| (mask >> (32 - n)) & 1 == 0).map(|n| n.to_string()).collect();
+    ir_note(&format!("INTC mask t={:.1} value={:08X} enabled interrupts: {}", now * 1e6, mask, on.join(" ")));
+}
+
+fn ir_note(text: &str) {
+    use std::io::Write;
+    if let Some(t) = IR_TRACE.lock().unwrap().as_mut() {
+        let _ = writeln!(t.out, "# {}", text);
+    }
+}
+
+/// Partner rules (TG18_IR_REACT=<rule>;<rule>...): each rule is `PATTERN>RESPONSE`, dot-separated
+/// byte tokens. PATTERN is matched against the start of a frame the toy sent (address, control,
+/// data, no checksum); `xx` matches any byte. RESPONSE is sent back (framed, checksummed) about
+/// TG18_IR_RX_GAP seconds after the toy's frame ends; `@N` copies byte N of the toy's frame,
+/// `@N+K` copies K bytes from N. The first matching rule wins.
+static IR_REACT: std::sync::Mutex<Vec<(Vec<Option<u8>>, Vec<String>)>> = std::sync::Mutex::new(Vec::new());
+static IR_OUTBOX: std::sync::Mutex<std::collections::VecDeque<Vec<u8>>> = std::sync::Mutex::new(std::collections::VecDeque::new());
+static IR_BRIDGE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static IR_PARTNER: std::sync::Mutex<Option<crate::irpartner::Partner>> = std::sync::Mutex::new(None);
+static IR_REACT_MAX: std::sync::Mutex<Vec<(u32, u32)>> = std::sync::Mutex::new(Vec::new());
+static IR_REACT_OUT: std::sync::Mutex<std::collections::VecDeque<(f64, Vec<u8>)>> = std::sync::Mutex::new(std::collections::VecDeque::new());
+static IR_REACT_DEFRAME: std::sync::Mutex<(bool, bool, Vec<u8>)> = std::sync::Mutex::new((false, false, Vec::new()));
+
+/// One toy's infrared line, so two toys can run in one process and talk to each other.
+/// The core keeps the line in process-wide state; `ir_ctx_swap` moves a toy's own line in
+/// before it runs and out again after. With `bridge` on, every frame the toy sends is
+/// queued in `outbox` (address, control, data - no checksum) for the host to hand to the
+/// other toy with `deliver`, which plays it into this toy's receiver `due` seconds from now.
+#[derive(Default)]
+pub struct IrCtx {
+    pub rx: std::collections::VecDeque<u8>,
+    pub react_out: std::collections::VecDeque<(f64, Vec<u8>)>,
+    pub deframe: (bool, bool, Vec<u8>),
+    pub outbox: std::collections::VecDeque<Vec<u8>>,
+    pub bridge: bool,
+}
+
+impl IrCtx {
+    pub fn deliver(&mut self, body: &[u8], due: f64) {
+        self.react_out.push_back((due, ir_build_frame(body)));
+    }
+}
+
+pub fn ir_ctx_swap(c: &mut IrCtx) {
+    std::mem::swap(&mut *IR_RX.lock().unwrap(), &mut c.rx);
+    std::mem::swap(&mut *IR_REACT_OUT.lock().unwrap(), &mut c.react_out);
+    std::mem::swap(&mut *IR_REACT_DEFRAME.lock().unwrap(), &mut c.deframe);
+    std::mem::swap(&mut *IR_OUTBOX.lock().unwrap(), &mut c.outbox);
+    let b = IR_BRIDGE.swap(c.bridge, std::sync::atomic::Ordering::Relaxed);
+    c.bridge = b;
+}
+
+fn ir_fcs16(data: &[u8]) -> u16 {
+    let mut fcs: u16 = 0xFFFF;
+    for &b in data {
+        fcs ^= b as u16;
+        for _ in 0..8 {
+            fcs = if fcs & 1 != 0 { (fcs >> 1) ^ 0x8408 } else { fcs >> 1 };
+        }
+    }
+    fcs ^ 0xFFFF
+}
+
+fn ir_build_frame(body: &[u8]) -> Vec<u8> {
+    let f = ir_fcs16(body);
+    let mut full = body.to_vec();
+    full.push((f & 0xFF) as u8);
+    full.push((f >> 8) as u8);
+    let mut out = vec![0xC0u8; 4];
+    for b in full {
+        if b == 0xC0 || b == 0xC1 || b == 0x7D {
+            out.push(0x7D);
+            out.push(b ^ 0x20);
+        } else {
+            out.push(b);
+        }
+    }
+    out.push(0xC1);
+    out
+}
+
+fn ir_react_expand(tokens: &[String], recv: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    for t in tokens {
+        if let Some(rest) = t.strip_prefix('@') {
+            let (a, n) = match rest.split_once('+') {
+                Some((a, n)) => (a.parse::<usize>().unwrap_or(0), n.parse::<usize>().unwrap_or(1)),
+                None => (rest.parse::<usize>().unwrap_or(0), 1),
+            };
+            for i in a..a + n {
+                out.push(*recv.get(i).unwrap_or(&0));
+            }
+        } else if let Ok(b) = u8::from_str_radix(t, 16) {
+            out.push(b);
+        }
+    }
+    out
+}
+
+fn ir_react_match(now: f64, body: &[u8]) -> Option<(f64, Vec<u8>, String)> {
+    if IR_BRIDGE.load(std::sync::atomic::Ordering::Relaxed) {
+        IR_OUTBOX.lock().unwrap().push_back(body.to_vec());
+        return Some((f64::MAX, Vec::new(), format!("LINK frame of {} byte(s) to the other toy at t={:.1}", body.len(), now * 1e6)));
+    }
+    if let Some(p) = IR_PARTNER.lock().unwrap().as_mut() {
+        let (resp, note) = p.handle(body);
+        let hex: String = body.iter().take(24).map(|x| format!("{:02x}", x)).collect();
+        let gap = *IR_RX_GAP.lock().unwrap();
+        return Some(match resp {
+            Some(r) => (now + gap, ir_build_frame(&r), format!("PARTNER t={:.1} toy {}.. [{}] -> reply {} byte(s)", now * 1e6, hex, note, r.len())),
+            None => (f64::MAX, Vec::new(), format!("PARTNER t={:.1} toy {}.. [{}] -> no reply", now * 1e6, hex, note)),
+        });
+    }
+    let rules = IR_REACT.lock().unwrap();
+    let mut maxes = IR_REACT_MAX.lock().unwrap();
+    for (i, (pat, resp)) in rules.iter().enumerate() {
+        if let Some(m) = maxes.get(i) {
+            if m.0 != 0 && m.1 >= m.0 {
+                continue;
+            }
+        }
+        if body.len() >= pat.len() && pat.iter().zip(body.iter()).all(|(p, x)| p.map_or(true, |v| v == *x)) {
+            if let Some(m) = maxes.get_mut(i) {
+                m.1 += 1;
+            }
+            let out = ir_react_expand(resp, body);
+            let frame = ir_build_frame(&out);
+            let gap = *IR_RX_GAP.lock().unwrap();
+            let hex: String = body.iter().map(|x| format!("{:02x}", x)).collect();
+            return Some((now + gap, frame, format!("REACT rule {} matched toy frame {} at t={:.1}", i, hex, now * 1e6)));
+        }
+    }
+    let hex: String = body.iter().map(|x| format!("{:02x}", x)).collect();
+    Some((f64::MAX, Vec::new(), format!("REACT no rule for toy frame {} at t={:.1}", hex, now * 1e6)))
+}
+
+/// Feed one byte the toy transmitted; returns a reaction once a whole frame has been seen.
+fn ir_react_feed(now: f64, b: u8) -> Option<(f64, Vec<u8>, String)> {
+    if IR_REACT.lock().unwrap().is_empty() && IR_PARTNER.lock().unwrap().is_none() && !IR_BRIDGE.load(std::sync::atomic::Ordering::Relaxed) {
+        return None;
+    }
+    let mut st = IR_REACT_DEFRAME.lock().unwrap();
+    if b == 0xC0 {
+        st.0 = true;
+        st.1 = false;
+        st.2.clear();
+        return None;
+    }
+    if !st.0 {
+        return None;
+    }
+    if b == 0xC1 {
+        st.0 = false;
+        let mut body = std::mem::take(&mut st.2);
+        drop(st);
+        if body.len() < 4 {
+            return None;
+        }
+        body.truncate(body.len() - 2);
+        return ir_react_match(now, &body);
+    }
+    if st.1 {
+        st.1 = false;
+        st.2.push(b ^ 0x20);
+    } else if b == 0x7D {
+        st.1 = true;
+    } else {
+        st.2.push(b);
+    }
+    None
+}
+
+static IR_GPIO_LAST: std::sync::Mutex<Option<std::collections::HashMap<u32, u32>>> = std::sync::Mutex::new(None);
+static IR_GPIO_LINES: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+/// Log reads and writes of the GPIO pin block (plain memory here, so the UART trace
+/// never saw it): a read only when its value changed, a write only when it changes
+/// what was last written. Lines look like `t G<offset> R|W size value pc=...`.
+fn ir_gpio_log(now: f64, pc: u32, off: u32, write: bool, size: u32, val: u32) {
+    use std::io::Write;
+    {
+        let mut last = IR_GPIO_LAST.lock().unwrap();
+        let map = last.get_or_insert_with(std::collections::HashMap::new);
+        let key = off | if write { 0x8000_0000 } else { 0 };
+        if map.get(&key) == Some(&val) {
+            return;
+        }
+        map.insert(key, val);
+    }
+    if IR_GPIO_LINES.fetch_add(1, std::sync::atomic::Ordering::Relaxed) >= 30_000 {
+        return;
+    }
+    let mut g = IR_TRACE.lock().unwrap();
+    if let Some(t) = g.as_mut() {
+        let _ = writeln!(t.out, "{:.1} G{:03X} {} {} {:X} pc={:08X}", now * 1e6, off, if write { 'W' } else { 'R' }, size, val, pc);
+    }
+}
+
+fn ir_rx_len() -> usize {
+    IR_RX.lock().unwrap().len()
+}
+
+fn ir_rx_pop() -> u8 {
+    IR_RX.lock().unwrap().pop_front().unwrap_or(0)
+}
+
+/// The firmware just started a session: schedule the test bytes.
+fn ir_arm_rx(now: f64) {
+    if IR_RX_DONE.load(std::sync::atomic::Ordering::Relaxed) || IR_RX_DATA.lock().unwrap().is_empty() {
+        return;
+    }
+    let delay = *IR_RX_DELAY.lock().unwrap();
+    let mut due = IR_RX_DUE.lock().unwrap();
+    if due.is_none() {
+        *due = Some(now + delay);
+    }
+}
+
+/// Called as emulated time advances: deliver the test bytes when they are due.
+fn ir_rx_tick(now: f64) {
+    if !IR_TRACE_ON.load(std::sync::atomic::Ordering::Relaxed) {
+        return;
+    }
+    let ready_frame: Option<Vec<u8>> = {
+        let mut q = IR_REACT_OUT.lock().unwrap();
+        let ready = match q.front() {
+            Some(f) => now >= f.0,
+            None => false,
+        };
+        if ready { q.pop_front().map(|f| f.1) } else { None }
+    };
+    if let Some(f) = ready_frame {
+        IR_RX.lock().unwrap().extend(f.iter().copied());
+        ir_note(&format!("REACT injected {} byte(s) at t={:.1}", f.len(), now * 1e6));
+    }
+    let mut due = IR_RX_DUE.lock().unwrap();
+    let current: Option<f64> = *due;
+    if let Some(t) = current {
+        if now >= t {
+            *due = None;
+            let first = !IR_RX_DONE.swap(true, std::sync::atomic::Ordering::Relaxed);
+            let data: Vec<u8> = if first {
+                IR_RX_DATA.lock().unwrap().clone()
+            } else {
+                IR_RX_NEXT.lock().unwrap().pop_front().map(|f| f.1).unwrap_or_default()
+            };
+            let next_timed: bool = IR_RX_NEXT.lock().unwrap().front().map(|f| f.0).unwrap_or(false);
+            if next_timed {
+                *due = Some(now + *IR_RX_STEP.lock().unwrap());
+            }
+            IR_RX.lock().unwrap().extend(data.iter().copied());
+            drop(due);
+            ir_note(&format!("INJECTED {} byte(s) at t={:.1}", data.len(), now * 1e6));
+        }
+    }
+}
+
+fn ir_log(now: f64, pc: u32, thumb: bool, off: u32, write: bool, size: u32, val: u32) {
+    use std::io::Write;
+    let mut g = IR_TRACE.lock().unwrap();
+    let t = match g.as_mut() {
+        Some(t) => t,
+        None => return,
+    };
+    let mut want_dump = false;
+    if write && off == 0x0C && val == 0x341 {
+        ir_arm_rx(now);
+    }
+    if write && off == 0 {
+        if let Some((due, frame, note)) = ir_react_feed(now, (val & 0xFF) as u8) {
+            let _ = writeln!(t.out, "# {}", note);
+            if !frame.is_empty() {
+                IR_REACT_OUT.lock().unwrap().push_back((due, frame));
+            }
+        }
+    }
+    // The toy just finished a frame (EOF byte): schedule the next scripted frame.
+    if write && off == 0 && (val & 0xFF) == 0xC1 && IR_RX_DONE.load(std::sync::atomic::Ordering::Relaxed) {
+        if !IR_RX_NEXT.lock().unwrap().is_empty() {
+            let gap = *IR_RX_GAP.lock().unwrap();
+            let mut due = IR_RX_DUE.lock().unwrap();
+            if due.is_none() {
+                *due = Some(now + gap);
+            }
+        }
+    }
+    if !write {
+        if off == 0x10 {
+            t.status_reads += 1;
+            if t.status_reads == 20_000 || t.status_reads == 20_000_000 {
+                want_dump = true;
+            }
+        }
+        if (off == 0x00 || off == 0x04) && IR_RX_DONE.load(std::sync::atomic::Ordering::Relaxed) && t.rx_dumps < 4 {
+            t.rx_dumps += 1;
+            want_dump = true;
+        }
+    } else if off == 0 && t.tx_dumps < 3 {
+        t.tx_dumps += 1;
+        want_dump = true;
+    }
+    if want_dump {
+        IR_DUMP_PC.store(pc, std::sync::atomic::Ordering::Relaxed);
+        IR_DUMP_THUMB.store(thumb, std::sync::atomic::Ordering::Relaxed);
+        IR_WANT_DUMP.store(true, std::sync::atomic::Ordering::Relaxed);
+    }
+    if !write {
+        if t.last_read.get(&off) == Some(&val) {
+            t.skipped += 1;
+            if t.skipped % 50_000_000 == 0 {
+                let _ = writeln!(t.out, "# still waiting: {} identical reads so far (t={:.1})", t.skipped, now * 1e6);
+            }
+            return;
+        }
+        t.last_read.insert(off, val);
+    }
+    if t.skipped > 0 {
+        let _ = writeln!(t.out, "# {} identical reads skipped, until t={:.1}", t.skipped, now * 1e6);
+        t.skipped = 0;
+    }
+    if write {
+        t.last_read.clear();
+    }
+    if t.lines >= IR_TRACE_MAX_LINES {
+        return;
+    }
+    t.lines += 1;
+    let _ = writeln!(
+        t.out,
+        "{:.1} {:02X} {} {} {:X}",
+        now * 1e6,
+        off,
+        if write { 'W' } else { 'R' },
+        size,
+        val
+    );
+}
