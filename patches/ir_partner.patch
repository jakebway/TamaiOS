diff --git a/core/src/sys.rs b/core/src/sys.rs
index a4970c0..1d6a0ab 100644
--- a/core/src/sys.rs
+++ b/core/src/sys.rs
@@ -9,6 +9,495 @@ use std::hash::{BuildHasherDefault, Hasher};
 use crate::cpu::Bus;
 use crate::*;
 
+// --- infrared trace (TG18_IR_TRACE=<file>) --------------------------------
+//
+// With the variable set, the first IR access no longer stops the game (and the
+// port stays a real register block instead of turning into plain memory).
+// The file gets:
+//   * every WRITE to the UART:      `t_us offset W size value`
+//   * a READ only when its value differs from the previous read of that
+//     register (or is the first read after a write): `t_us offset R size value`
+//   * `# N identical reads skipped` summaries, so waiting for a partner costs
+//     a few lines per second instead of millions
+//   * `# CODE ...` lines: the machine code around the polling loop, to read
+//     what the firmware tests (printed after 20000 and 20000000 status reads)
+// Time is the emulated clock, refreshed every 1000 instructions (~10 us).
+
+static IR_TRACE_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static IR_WANT_DUMP: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// What the status register (+0x10) reads while tracing. Bit 4 = receive FIFO
+/// empty (cleared while bytes wait), bit 14 = transmitter ready (interrupt
+/// source), bit 7 = transmitter empty, bit 5 = transmit FIFO full, bit 3 = busy.
+/// Override with TG18_IR_STATUS=<hex>.
+static IR_STATUS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0x4090);
+/// Interrupt number of the UART (the firmware registers interrupt 14 for it).
+static IR_IRQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(14);
+/// Value of +0x04 while received bytes are waiting (TG18_IR_ISR=<hex>).
+static IR_ISR: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+/// Test bytes to feed the firmware (TG18_IR_RX=<hex bytes>), once, TG18_IR_RX_DELAY
+/// seconds (default 2) after the firmware first switches the port to 0x341.
+static IR_RX: std::sync::Mutex<std::collections::VecDeque<u8>> = std::sync::Mutex::new(std::collections::VecDeque::new());
+static IR_RX_DATA: std::sync::Mutex<Vec<u8>> = std::sync::Mutex::new(Vec::new());
+static IR_RX_DUE: std::sync::Mutex<Option<f64>> = std::sync::Mutex::new(None);
+static IR_RX_DELAY: std::sync::Mutex<f64> = std::sync::Mutex::new(2.0);
+/// Further frames (TG18_IR_RX is ';'-separated). Each is sent TG18_IR_RX_GAP seconds
+/// (default 0.05) after the toy finishes sending a frame (it writes the EOF byte 0xC1).
+/// A frame written with a leading '+' is instead sent TG18_IR_RX_STEP seconds (default 0.3)
+/// after the previous one was fed in, for frames the toy does not answer.
+static IR_RX_NEXT: std::sync::Mutex<std::collections::VecDeque<(bool, Vec<u8>)>> = std::sync::Mutex::new(std::collections::VecDeque::new());
+static IR_RX_GAP: std::sync::Mutex<f64> = std::sync::Mutex::new(0.05);
+static IR_RX_STEP: std::sync::Mutex<f64> = std::sync::Mutex::new(0.3);
+static IR_RX_DONE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static IR_DUMP_PC: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static IR_DUMP_THUMB: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static IR_TRACE: std::sync::Mutex<Option<IrTrace>> = std::sync::Mutex::new(None);
+const IR_TRACE_MAX_LINES: u64 = 400_000;
+
+struct IrTrace {
+    out: std::io::LineWriter<std::fs::File>,
+    last_read: std::collections::HashMap<u32, u32>,
+    skipped: u64,
+    status_reads: u64,
+    tx_dumps: u64,
+    rx_dumps: u64,
+    lines: u64,
+}
