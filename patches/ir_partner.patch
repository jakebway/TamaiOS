diff --git a/core/src/bin/irlink.rs b/core/src/bin/irlink.rs
new file mode 100644
index 0000000..726d79e
--- /dev/null
+++ b/core/src/bin/irlink.rs
@@ -0,0 +1,62 @@
+//! Two toys in one process, their infrared lines joined: irlink <rom> <snapA> <snapB> <seconds>
+//! Both start from a snapshot (e.g. at the PLAYDATE menu). Presses: A and B choose the first
+//! menu entry at 0.3 s, then A presses B again at 6 s to start the connection.
+use std::sync::Arc;
+use tg18::snapshot::Snapshot;
+use tg18::sys::{ir_ctx_swap, IrCtx};
+use tg18::{Key, Machine, CPU_HZ};
+
+fn load(image: &Arc<Vec<u8>>, p: &str) -> Machine {
+    let mut m = Machine::new(image.clone(), image, 0.0);
+    Snapshot::load(p).and_then(|s| s.restore(&mut m)).expect("snapshot");
+    m
+}
+
+fn main() {
+    std::env::set_var("TG18_IR_TRACE", "/dev/null");
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let image = Arc::new(std::fs::read(&a[0]).unwrap());
+    let secs: f64 = a[3].parse().unwrap();
+    let mut m = [load(&image, &a[1]), load(&image, &a[2])];
+    let mut ctx = [IrCtx::default(), IrCtx::default()];
+    ctx[0].bridge = true;
+    ctx[1].bridge = true;
+    let t0 = [m[0].now(), m[1].now()];
+    for i in 0..2 {
+        m[i].press(t0[i] + 0.3, Key::B);
+    }
+    m[0].press(t0[0] + 6.0, Key::B);
+    let slice = (0.005 * CPU_HZ) as u64;
+    let mut frames = [0usize; 2];
+    let mut step = 0u64;
+    loop {
+        let el = m[0].now() - t0[0];
+        if el >= secs {
+            break;
+        }
+        for i in 0..2 {
+            ir_ctx_swap(&mut ctx[i]);
+            let end = m[i].executed + slice;
+            m[i].run_with_sleep(end);
+            ir_ctx_swap(&mut ctx[i]);
+        }
+        for i in 0..2 {
+            while let Some(f) = ctx[i].outbox.pop_front() {
+                frames[i] += 1;
+                let j = 1 - i;
+                let due = m[j].now() + 0.002;
+                if step % 1 == 0 {
+                    println!("t={:.3} toy {} -> toy {}: {} bytes {:02x?}", el, i, j, f.len(), &f[..f.len().min(6)]);
+                }
+                ctx[j].deliver(&f, due);
+            }
+        }
+        step += 1;
+    }
+    println!("frames A->B {} B->A {}", frames[0], frames[1]);
+    for i in 0..2 {
+        let rgb = m[i].lcd_rgb();
+        let (w, h) = Machine::screen_size();
+        let _ = tg18::png::write(&format!("link_{}.png", i), w, h, &rgb, 2);
+    }
+}
