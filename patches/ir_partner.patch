+pub fn ir_trace_init() {
+    use std::io::Write;
+    if IR_TRACE_ON.load(std::sync::atomic::Ordering::Relaxed) {
+        return; // already open (the machine can be rebuilt)
+    }
+    if let Some(path) = std::env::var_os("TG18_IR_TRACE") {
+        if let Ok(f) = std::fs::File::create(&path) {
+            let mut t = IrTrace {
+                out: std::io::LineWriter::new(f),
+                last_read: std::collections::HashMap::new(),
+                skipped: 0,
+                status_reads: 0,
+                tx_dumps: 0,
+                rx_dumps: 0,
+                lines: 0,
+            };
+            let _ = writeln!(t.out, "# t_us offset dir size value");
+            if let Some(v) = std::env::var("TG18_IR_STATUS").ok().and_then(|v| u32::from_str_radix(v.trim_start_matches("0x"), 16).ok()) {
+                IR_STATUS.store(v, std::sync::atomic::Ordering::Relaxed);
+            }
+            if let Ok(v) = std::env::var("TG18_IR_RX") {
+                let mut frames: Vec<(bool, Vec<u8>)> = Vec::new();
+                for part in v.split(';') {
+                    let timed = part.trim_start().starts_with('+');
+                    let hex: String = part.chars().filter(|c| c.is_ascii_hexdigit()).collect();
+                    let bytes: Vec<u8> = (0..hex.len() / 2).filter_map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).ok()).collect();
+                    if !bytes.is_empty() {
+                        let _ = writeln!(t.out, "# will feed frame {}: {} byte(s): {}", frames.len(), bytes.len(), hex);
+                        frames.push((timed, bytes));
+                    }
+                }
+                if !frames.is_empty() {
+                    *IR_RX_DATA.lock().unwrap() = frames.remove(0).1;
+                    IR_RX_NEXT.lock().unwrap().extend(frames);
+                }
+            }
+            if std::env::var("TG18_IR_PARTNER").is_ok() {
+                let mut p = crate::irpartner::Partner::new();
+                p.dump_dir = std::env::var("TG18_IR_DUMP").ok();
+                if let Ok(v) = std::env::var("TG18_IR_PATCH") {
+                    p.set_patches(&v);
+                }
+                *IR_PARTNER.lock().unwrap() = Some(p);
+                let _ = writeln!(t.out, "# partner: built-in IR partner on");
+            }
+            if let Ok(v) = std::env::var("TG18_IR_REACT") {
+                let mut rules = IR_REACT.lock().unwrap();
+                for rule in v.split(';') {
+                    if let Some((p, r)) = rule.split_once('>') {
+                        // optional "*N" at the end: use this rule at most N times
+                        let (r, maxn) = match r.rsplit_once('*') {
+                            Some((a, n)) => (a, n.trim().parse::<u32>().unwrap_or(0)),
+                            None => (r, 0),
+                        };
+                        IR_REACT_MAX.lock().unwrap().push((maxn, 0));
+                        let pat: Vec<Option<u8>> = p.split('.').map(|t| u8::from_str_radix(t, 16).ok()).collect();
+                        let resp: Vec<String> = r.split('.').map(|t| t.to_string()).collect();
+                        let _ = writeln!(t.out, "# partner rule {}: {} > {}", rules.len(), p, r);
+                        rules.push((pat, resp));
+                    }
+                }
+            }
+            if let Some(g) = std::env::var("TG18_IR_RX_GAP").ok().and_then(|v| v.parse::<f64>().ok()) {
+                *IR_RX_GAP.lock().unwrap() = g;
+            }
+            if let Some(g) = std::env::var("TG18_IR_RX_STEP").ok().and_then(|v| v.parse::<f64>().ok()) {
+                *IR_RX_STEP.lock().unwrap() = g;
+            }
+            if let Some(d) = std::env::var("TG18_IR_RX_DELAY").ok().and_then(|v| v.parse::<f64>().ok()) {
+                *IR_RX_DELAY.lock().unwrap() = d;
+            }
+            if let Some(n) = std::env::var("TG18_IR_IRQ").ok().and_then(|v| v.parse::<u32>().ok()) {
+                IR_IRQ.store(n, std::sync::atomic::Ordering::Relaxed);
+            }
+            if let Some(v) = std::env::var("TG18_IR_ISR").ok().and_then(|v| u32::from_str_radix(v.trim_start_matches("0x"), 16).ok()) {
+                IR_ISR.store(v, std::sync::atomic::Ordering::Relaxed);
+            }
+            *IR_TRACE.lock().unwrap() = Some(t);
+            IR_TRACE_ON.store(true, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
