diff --git a/core/src/irpartner.rs b/core/src/irpartner.rs
new file mode 100644
index 0000000..875ba1a
--- /dev/null
+++ b/core/src/irpartner.rs
@@ -0,0 +1,408 @@
+//! A pretend second Tamagotchi on the infrared link.
+//!
+//! The toy talks IrDA: IrLAP (link) > IrLMP (multiplexing) > TinyTP (flow control) > OBEX
+//! (file transfer). When you press B on WAITING it becomes the IrLAP primary and walks the
+//! whole stack against us. This module is the other end: feed it every frame the toy sends
+//! (address, control, data, no checksum) and it says what to send back, if anything.
+//!
+//! What PLAYDATE / GIFT / MARRY turned out to be, as seen from here: an OBEX session where
+//! the toy PUTs a 512-byte "put1.jpg" (a TAMAGO info block), GETs "get1.jpg" (ours), PUTs
+//! "put2.jpg" (the big character data) and GETs "get2.jpg".
+
+use std::collections::{HashMap, VecDeque};
+
+/// Our IrLAP device address.
+pub const OUR_ADDR: [u8; 4] = [0x12, 0x34, 0x56, 0x78];
+/// The link parameters we accept (9600 baud, 500 ms turnaround, 512-byte frames, window 1).
+const QOS: [u8; 21] = [
+    0x01, 0x01, 0x02, 0x82, 0x01, 0x01, 0x83, 0x01, 0x0F, 0x84, 0x01, 0x01, 0x85, 0x01, 0x81, 0x86, 0x01, 0x07, 0x08, 0x01, 0x01,
+];
+/// How many data bytes the toy puts in one frame.
+const PDU_MAX: usize = 477;
+/// How much file data goes in one OBEX packet (the toy's own packet limit is 508).
+const BODY_MAX: usize = 496;
+/// The LSAP (port) the toy's OBEX server listens on.
+const LSAP_OBEX: u8 = 3;
+
+#[derive(Default)]
+pub struct Partner {
+    /// Files the toy PUT to us, by name ("put1.jpg" ...).
+    pub files_in: HashMap<String, Vec<u8>>,
+    /// Files we offer when the toy GETs them ("get1.jpg" ...). A missing one falls back
+    /// to the matching file the toy sent us, so a toy meeting a clone of itself works.
+    pub files_out: HashMap<String, Vec<u8>>,
+    /// Where to save every file the toy sends us (the folder must exist).
+    pub dump_dir: Option<String>,
+    /// Byte patches for the files we hand out: (file name, offset, new bytes).
+    pub patches: Vec<(String, usize, Vec<u8>)>,
+
+    caddr: Option<u8>,
+    ns: u8,
+    nr: u8,
+    out: VecDeque<Vec<u8>>,
+    ias_open: bool,
+    obex_open: bool,
+    obex_toy_lsap: u8,
+    rx: Vec<u8>,
+    put_name: String,
+    put_buf: Vec<u8>,
+    get_data: Vec<u8>,
+    get_pos: usize,
+    credit_given: i32,
+    notes: Vec<String>,
+}
+
+fn cstr16(b: &[u8]) -> String {
+    let mut s = String::new();
+    for c in b.chunks(2) {
+        if c.len() < 2 {
+            break;
+        }
+        let u = (c[0] as u16) << 8 | c[1] as u16;
+        if u == 0 {
+            break;
+        }
+        s.push(char::from_u32(u as u32).unwrap_or('?'));
+    }
+    s
+}
+
+impl Partner {
+    pub fn new() -> Partner {
+        Partner::default()
+    }
+
+    /// Parse "get1.jpg:72=1234,get1.jpg:8a=00" (offset in hex, bytes in hex).
+    pub fn set_patches(&mut self, spec: &str) {
+        for item in spec.split(',') {
+            let Some((name, rest)) = item.split_once(':') else { continue };
+            let Some((off, hex)) = rest.split_once('=') else { continue };
+            let Ok(off) = usize::from_str_radix(off.trim(), 16) else { continue };
+            let bytes: Vec<u8> = (0..hex.len() / 2).filter_map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).ok()).collect();
+            self.patches.push((name.trim().to_string(), off, bytes));
+        }
+    }
+
+    /// One frame from the toy in, the frame to answer with out.
+    pub fn handle(&mut self, b: &[u8]) -> (Option<Vec<u8>>, String) {
+        self.notes.clear();
+        let reply = self.frame(b);
+        (reply, self.notes.join("; "))
+    }
+
+    fn note(&mut self, s: impl Into<String>) {
+        self.notes.push(s.into());
+    }
+
+    fn frame(&mut self, b: &[u8]) -> Option<Vec<u8>> {
+        if b.len() < 2 {
+            return None;
+        }
+        let (addr, ctrl) = (b[0], b[1]);
+        if addr == 0xFF {
+            match ctrl & 0xEF {
+                // discovery: answer only the first slot
+                0x2F if b.len() >= 13 && b[12] == 0 => {
+                    self.note("XID slot 0 -> discovery reply");
+                    let mut r = vec![0xFE, 0xBF, 0x01];
+                    r.extend_from_slice(&OUR_ADDR);
+                    r.extend_from_slice(&b[3..7]);
+                    r.extend_from_slice(&[0x00, 0x00, 0x00, 0x80, 0x20, 0x00]);
+                    r.extend_from_slice(b"TMGC");
+                    return Some(r);
+                }
+                // connect request
+                0x83 if b.len() >= 11 => return Some(self.snrm(b)),
+                _ => return None,
+            }
+        }
+        let caddr = self.caddr?;
+        if addr != caddr | 1 {
+            return None;
+        }
+        let poll = ctrl & 0x10 != 0;
+        if ctrl & 1 == 0 {
+            // information frame
+            let ns_in = (ctrl >> 1) & 7;
+            if ns_in == self.nr {
+                self.nr = (self.nr + 1) & 7;
+                self.link_data(&b[2..]);
+            } else {
+                self.note(format!("I-frame out of order (got {} want {})", ns_in, self.nr));
+            }
+            return if poll { Some(self.turn()) } else { None };
+        }
+        if ctrl & 3 == 1 {
+            // supervisory: RR/RNR/REJ/SREJ, all just a turn for us
+            return if poll { Some(self.turn()) } else { None };
+        }
+        match ctrl & 0xEF {
+            0x43 => {
+                self.note("DISC -> UA");
+                self.reset_link();
+                Some(vec![caddr, 0x73])
+            }
+            0x83 => Some(self.snrm(b)),
+            _ => None,
+        }
+    }
+
+    fn reset_link(&mut self) {
+        self.ns = 0;
+        self.nr = 0;
+        self.out.clear();
+        self.ias_open = false;
+        self.obex_open = false;
+        self.rx.clear();
+        self.get_data.clear();
+        self.get_pos = 0;
+    }
+
+    fn snrm(&mut self, b: &[u8]) -> Vec<u8> {
+        self.reset_link();
+        let caddr = b[10];
+        self.caddr = Some(caddr);
+        self.note(format!("SNRM conn addr {:02x} -> UA", caddr));
+        let mut r = vec![caddr, 0x73];
+        r.extend_from_slice(&b[6..10]);
+        r.extend_from_slice(&b[2..6]);
+        r.extend_from_slice(&QOS);
+        r
+    }
+
+    /// The toy gave us the turn: send the next queued message, or just an acknowledgement.
+    fn turn(&mut self) -> Vec<u8> {
+        let caddr = self.caddr.unwrap_or(0);
+        if let Some(pdu) = self.out.pop_front() {
+            let ctrl = (self.nr << 5) | 0x10 | (self.ns << 1);
+            self.ns = (self.ns + 1) & 7;
+            let mut r = vec![caddr, ctrl];
+            r.extend_from_slice(&pdu);
+            r
+        } else {
+            vec![caddr, (self.nr << 5) | 0x10 | 1]
+        }
+    }
+
+    /// IrLMP: one frame's worth of data.
+    fn link_data(&mut self, d: &[u8]) {
+        if d.len() < 2 {
+            return;
+        }
+        let (b0, b1) = (d[0], d[1]);
+        if b0 & 0x80 != 0 {
+            // link control
+            let dlsap = b0 & 0x7F;
+            let slsap = b1 & 0x7F;
+            match d.get(2).copied() {
+                Some(0x01) => {
+                    if dlsap == 0 {
+                        self.note("LM connect IAS");
+                        self.ias_open = true;
+                        self.out.push_back(vec![slsap | 0x80, 0x00, 0x81, 0x00]);
+                    } else if dlsap == LSAP_OBEX {
+                        self.note("LM connect OBEX");
+                        self.obex_open = true;
+                        self.obex_toy_lsap = slsap;
+                        self.rx.clear();
+                        self.credit_given = 127;
+                        self.out.push_back(vec![slsap | 0x80, LSAP_OBEX, 0x81, 0x00, 0x7F]);
+                    }
+                }
+                Some(0x02) => {
+                    self.note(format!("LM disconnect lsap {}", dlsap));
+                    if dlsap == 0 {
+                        self.ias_open = false;
+                    } else if dlsap == LSAP_OBEX {
+                        self.obex_open = false;
+                    }
+                }
+                _ => {}
+            }
+            return;
+        }
+        let payload = &d[2..];
+        if b0 == 0 {
+            self.ias(b1 & 0x7F, payload);
+        } else if b0 == LSAP_OBEX {
+            if payload.is_empty() {
+                return;
+            }
+            let data = &payload[1..];
+            if data.is_empty() {
+                return; // credit only
+            }
+            self.credit_given -= 1;
+            self.rx.extend_from_slice(data);
+            self.obex_rx();
+            if self.credit_given < 40 {
+                let more = (127 - self.credit_given).clamp(1, 127) as u8;
+                self.credit_given += more as i32;
+                self.out.push_back(vec![self.obex_toy_lsap, LSAP_OBEX, more]);
+            }
+        }
+    }
+
+    /// IAS, the toy's directory of ports: only the OBEX port lookup is answered.
+    fn ias(&mut self, toy_lsap: u8, p: &[u8]) {
+        if p.first().map(|x| x & 0x7F) != Some(4) || p.len() < 3 {
+            return;
+        }
+        let cl = p[1] as usize;
+        if p.len() < 3 + cl {
+            return;
+        }
+        let class = &p[2..2 + cl];
+        let al = p[2 + cl] as usize;
+        let attr = p.get(3 + cl..3 + cl + al).unwrap_or(&[]);
+        let class_s = String::from_utf8_lossy(class).to_string();
+        let attr_s = String::from_utf8_lossy(attr).to_string();
+        self.note(format!("IAS {}/{}", class_s, attr_s));
+        let mut r = vec![toy_lsap, 0x00, 0x84];
+        if class_s == "OBEX" && attr_s == "IrDA:TinyTP:LsapSel" {
+            r.extend_from_slice(&[0x00, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, LSAP_OBEX]);
+        } else {
+            r.push(0x01);
+        }
+        self.out.push_back(r);
+    }
+
+    /// Whole OBEX packets out of the byte stream (the toy cuts them into frames at will).
+    fn obex_rx(&mut self) {
+        loop {
+            if self.rx.len() < 3 {
+                return;
+            }
+            let len = (self.rx[1] as usize) << 8 | self.rx[2] as usize;
+            if len < 3 {
+                self.rx.clear();
+                return;
+            }
+            if self.rx.len() < len {
+                return;
+            }
+            let pkt: Vec<u8> = self.rx.drain(..len).collect();
+            self.obex_packet(&pkt);
+        }
+    }
+
+    /// Headers of an OBEX packet: (name, body, end-of-body flag).
+    fn headers(p: &[u8]) -> (Option<String>, Vec<u8>, bool) {
+        let mut i = 0;
+        let (mut name, mut body, mut end) = (None, Vec::new(), false);
+        while i < p.len() {
+            let id = p[i];
+            let n = match id >> 6 {
+                0 | 1 => {
+                    if i + 3 > p.len() {
+                        break;
+                    }
+                    let l = (p[i + 1] as usize) << 8 | p[i + 2] as usize;
+                    if l < 3 || i + l > p.len() {
+                        break;
+                    }
+                    let v = &p[i + 3..i + l];
+                    match id {
+                        0x01 => name = Some(cstr16(v)),
+                        0x48 => body.extend_from_slice(v),
+                        0x49 => {
+                            body.extend_from_slice(v);
+                            end = true;
+                        }
+                        _ => {}
+                    }
+                    l
+                }
+                2 => 2,
+                _ => 5,
+            };
+            i += n;
+        }
+        (name, body, end)
+    }
+
+    fn obex_packet(&mut self, p: &[u8]) {
+        let op = p[0];
+        match op {
+            0x80 => {
+                self.note("OBEX connect");
+                self.obex_send(&[0xA0, 0x00, 0x07, 0x10, 0x00, 0x01, 0xFC]);
+            }
+            0x81 => {
+                self.note("OBEX disconnect");
+                self.obex_send(&[0xA0, 0x00, 0x03]);
+            }
+            0x02 | 0x82 => {
+                let (name, body, end) = Self::headers(&p[3..]);
+                if let Some(n) = name {
+                    self.put_name = n;
+                    self.put_buf.clear();
+                }
+                self.put_buf.extend_from_slice(&body);
+                let last = op == 0x82 || end;
+                if last {
+                    let name = self.put_name.clone();
+                    let data = std::mem::take(&mut self.put_buf);
+                    self.note(format!("OBEX put {} complete, {} bytes", name, data.len()));
+                    if let Some(dir) = &self.dump_dir {
+                        let _ = std::fs::write(format!("{}/{}", dir, name), &data);
+                    }
+                    self.files_in.insert(name, data);
+                    self.obex_send(&[0xA0, 0x00, 0x03]);
+                } else {
+                    self.obex_send(&[0x90, 0x00, 0x03]);
+                }
+            }
+            0x03 | 0x83 => {
+                let (name, _, _) = Self::headers(&p[3..]);
+                if let Some(n) = name {
+                    let data = self.files_out.get(&n).cloned().or_else(|| self.files_in.get(&n.replacen("get", "put", 1)).cloned());
+                    self.note(format!("OBEX get {} ({} bytes available)", n, data.as_ref().map_or(0, |d| d.len())));
+                    match data {
+                        Some(mut d) => {
+                            for (pn, off, bytes) in &self.patches {
+                                if *pn == n && off + bytes.len() <= d.len() {
+                                    d[*off..*off + bytes.len()].copy_from_slice(bytes);
+                                }
+                            }
+                            if !self.patches.is_empty() && d.len() >= 258 && n == "get1.jpg" {
+                                // the 258-byte info packet ends in a 16-bit sum of the 256 bytes before it
+                                let sum = d[..256].iter().fold(0u16, |a, &b| a.wrapping_add(b as u16));
+                                d[256..258].copy_from_slice(&sum.to_le_bytes());
+                            }
+                            self.get_data = d;
+                            self.get_pos = 0;
+                        }
+                        None => {
+                            self.obex_send(&[0xC4, 0x00, 0x03]);
+                            return;
+                        }
+                    }
+                }
+                let left = self.get_data.len().saturating_sub(self.get_pos);
+                let n = left.min(BODY_MAX);
+                let last = n == left;
+                let chunk = self.get_data[self.get_pos..self.get_pos + n].to_vec();
+                self.get_pos += n;
+                let hl = n + 3;
+                let tl = hl + 3;
+                let mut r = vec![if last { 0xA0 } else { 0x90 }, (tl >> 8) as u8, tl as u8, if last { 0x49 } else { 0x48 }, (hl >> 8) as u8, hl as u8];
+                r.extend_from_slice(&chunk);
+                self.obex_send(&r);
+            }
+            _ => {
+                self.note(format!("OBEX opcode {:02x} not handled", op));
+                self.obex_send(&[0xD0, 0x00, 0x03]);
+            }
+        }
+    }
+
+    /// An OBEX packet to the toy, cut into frames the way the toy does it.
+    fn obex_send(&mut self, pkt: &[u8]) {
+        for (i, c) in pkt.chunks(PDU_MAX).enumerate() {
+            let mut v = vec![self.obex_toy_lsap, LSAP_OBEX, if i == 0 { 0x01 } else { 0x00 }];
+            v.extend_from_slice(c);
+            self.out.push_back(v);
+        }
+    }
+}
