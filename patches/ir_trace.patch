+// --- infrared trace (TG18_IR_TRACE=<file>) --------------------------------
+//
+// With the variable set, the first IR access no longer stops the game (and the
+// port stays a real register block instead of turning into plain memory), and
+// every UART access is logged as `t_us offset R|W size value`. Identical
+// back-to-back accesses (polling) are collapsed into one line plus a count.
+// Time is the emulated clock, refreshed every 1000 instructions (~10 us).
+
+static IR_TRACE_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static IR_TRACE: std::sync::Mutex<Option<IrTrace>> = std::sync::Mutex::new(None);
+const IR_TRACE_MAX_LINES: u64 = 400_000;
+
+struct IrTrace {
+    out: std::io::LineWriter<std::fs::File>,
+    last: Option<(u32, bool, u32, u32)>,
+    rep: u64,
+    lines: u64,
+}
+
+pub fn ir_trace_init() {
+    use std::io::Write;
+    if let Some(path) = std::env::var_os("TG18_IR_TRACE") {
+        if let Ok(f) = std::fs::File::create(&path) {
+            let mut t = IrTrace { out: std::io::LineWriter::new(f), last: None, rep: 0, lines: 0 };
+            let _ = writeln!(t.out, "# t_us offset dir size value   (xN = same access repeated N more times)");
+            *IR_TRACE.lock().unwrap() = Some(t);
+            IR_TRACE_ON.store(true, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+fn ir_log(now: f64, off: u32, write: bool, size: u32, val: u32) {
+    use std::io::Write;
+    let mut g = IR_TRACE.lock().unwrap();
+    let t = match g.as_mut() {
+        Some(t) => t,
+        None => return,
+    };
+    let key = (off, write, size, val);
+    if t.last == Some(key) {
+        t.rep += 1;
+        if t.rep % 1_000_000 == 0 {
+            let _ = writeln!(t.out, "#   still repeating, x{} so far (t={:.1})", t.rep, now * 1e6);
+        }
+        return;
+    }
+    if t.rep > 0 {
+        let _ = writeln!(t.out, "#   x{} more, until t={:.1}", t.rep, now * 1e6);
+        t.rep = 0;
+    }
+    if t.lines >= IR_TRACE_MAX_LINES {
+        if t.lines == IR_TRACE_MAX_LINES {
+            let _ = writeln!(t.out, "# trace truncated");
+            t.lines += 1;
+        }
+        return;
+    }
+    let _ = writeln!(
+        t.out,
+        "{:.1} {:02X} {} {} {:X}",
+        now * 1e6,
+        off,
+        if write { 'W' } else { 'R' },
+        size,
+        val
+    );
+    t.lines += 1;
+    t.last = Some(key);
+}
+
